{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stack",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "infra/docker-compose.yml",
        "up",
        "--build"
      ],
      "port": 13000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev",
        "--",
        "-p",
        "13000"
      ],
      "port": 13000
    },
    {
      "name": "api",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "apps/api",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8080"
      ],
      "port": 8080
    }
  ]
}
