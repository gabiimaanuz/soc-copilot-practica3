# ─── LLM ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_me
# Free tier daily request quotas vary by model:
#   gemini-2.5-flash       → ~20 req/día
#   gemini-2.5-flash-lite  → más generoso, recomendado para dev
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=soc
POSTGRES_PASSWORD=replace_with_strong_secret
POSTGRES_DB=soc_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ─── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=http://localhost:13500

# Rate limit (per client IP, in-memory). Disable for load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Auth (Phase 4) ────────────────────────────────────────────────────────
# Generate a real secret BEFORE deploying:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-32+chars-please-rotate-on-deploy
JWT_TTL_SECONDS=3600
COOKIE_NAME=soc_session
# Set to true ONLY behind HTTPS (Caddy in prod). In local dev keep false.
COOKIE_SECURE=false

# After bootstrap, set ALLOW_PUBLIC_REGISTRATION=false and create accounts
# from the admin panel. Leaving it true lets anyone self-register as an
# analyst.
ALLOW_PUBLIC_REGISTRATION=true

# Either "development" or "production". In production the API refuses to
# start with default JWT/Postgres secrets, hides Swagger, and forces
# secure cookies + HSTS.
APP_ENV=development

# ─── Per-user secrets ───────────────────────────────────────────────────────
# Fernet key (urlsafe base64, 32 bytes) — encrypts user-supplied Gemini
# API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Daily LLM call budget when a user is on the SHARED server key.
SERVER_LLM_DAILY_QUOTA=50

# Validez del enlace de «¿Has olvidado tu contraseña?» (minutos)
PASSWORD_RESET_TTL_MINUTES=30

# ─── MFA / TOTP (Práctica 2) ───────────────────────────────────────────────
# Second factor is MANDATORY for every user. Requires APP_ENCRYPTION_KEY
# (TOTP secrets are stored encrypted). Only test suites may set it to
# false; the API refuses to start in production with MFA_REQUIRED=false.
MFA_REQUIRED=true
MFA_ISSUER=SOC Copilot

# ─── Wazuh SIEM integration (Práctica 2) ───────────────────────────────────
# PUSH: Wazuh integratord → POST /api/integrations/wazuh/webhook
# Empty = webhook disabled. Generate with: openssl rand -hex 32
WAZUH_WEBHOOK_TOKEN=
# Alerts with rule.level below this are acknowledged but not stored.
WAZUH_MIN_RULE_LEVEL=7
# PULL: SOC Copilot queries the Wazuh Indexer (OpenSearch). Empty URL = off.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_INDEX=wazuh-alerts-*
# Path (inside the api container) to Wazuh's root-ca.pem. Preferred over
# disabling verification.
WAZUH_INDEXER_CA_CERT=
WAZUH_INDEXER_VERIFY_TLS=true
# Background poller interval in seconds. 0 = only manual "Sincronizar ahora".
WAZUH_POLL_INTERVAL_SECONDS=0

# ─── Web (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:13500
